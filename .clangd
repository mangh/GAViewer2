CompileFlags:
  CompilationDatabase: build
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    IgnoreHeader:
      # Windows SDK internals: include <windows.h> rather than its sub-headers
      - 'Windows Kits[/\\].*[/\\](um|shared)[/\\][^/\\]*'
      # libpng internals: include <png.h>
      - 'pngconf\.h'
      - 'pnglibconf\.h'
  # ClangTidy:
  #   Add: [modernize-*]
---
# Generated code (Gaigen, flex/bison): leave includes as generated
If:
  PathMatch:
    - viewer/src/(c3ga|c5ga|e3ga|i2ga|p3ga)/.*
    - viewer/src/typeset/font(lex|yacc)\..*
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
